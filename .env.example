POSTGRES_DB=complaints
POSTGRES_USER=complaints
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://complaints:change-me@db:5432/complaints
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO


# Assignment 2 cascade (assignment2/STEP2.md). false = Assignment 1 single-model behaviour using OLLAMA_MODEL.
CASCADE_ENABLED=false
CASCADE_SMALL_MODEL=gemma3:1b-it-q4_K_M
CASCADE_LARGE_MODEL=llama3.1:8b-instruct-q4_K_M
# Categories to ESCALATE (exact names, comma-separated); see STEP2.md §6.
# Setting A (accept Mortgage + Debt collection) is below. Setting B (accept Mortgage only): add ",Debt collection".
CASCADE_ESCALATE_ON=Credit reporting,Credit card,Bank account or service,Consumer loan,Money transfer or service
CASCADE_LABEL=
# Post-freeze (26 Nov): true = at most one Ollama call at a time in the cascade (speed-test variant *_lock).
CASCADE_SERIALIZE=false
